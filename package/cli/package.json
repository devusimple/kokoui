{
  "name": "@rnative/cli",
  "version": "0.0.2",
  "private": false,
  "type": "module",
  "description": "CLI for rnative (WIP shadcn-style React Native components)",
  "license": "ISC",
  "bin": {
    "rnative": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.0.0",
    "typescript": "6"
  },
  "keywords": [
    "react-native",
    "cli",
    "components",
    "shadcn",
    "rnative"
  ]
}